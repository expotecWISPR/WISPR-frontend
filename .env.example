# Copia este archivo a ".env" (mismo nombre, sin ".example"). El archivo ".env"
# está en .gitignore: nunca se sube al repo.

# --- MVP oficial: conectado con el backend FastAPI (repo WISPR) ---
# Con esta variable, este servidor atiende SOLO la terminal Kali y los archivos
# del frontend; cuentas, retos, flags y ranking los maneja FastAPI (Supabase),
# que tiene que estar corriendo en esa dirección. Los correos con el código de
# verificación también los manda FastAPI: aquí no hace falta SMTP.
# Si comentas esta línea, el prototipo funciona solo, sin FastAPI (ver abajo).
WISPR_BACKEND_URL=http://127.0.0.1:8000
# Dirección pública con la que se abre WISPR detrás de nginx (dominio o IP,
# separadas por coma). Solo en el servidor; en local no hace falta.
# WISPR_PUBLIC_HOSTS=wispr.ejemplo.com
# Cada cuántos segundos se revisa que la sesión de una terminal abierta siga valiendo.
# SESSION_RECHECK_SECONDS=60

# --- Solo si corres el prototipo SIN el backend (modo independiente) ---
# Credenciales SMTP para que los códigos de verificación lleguen de verdad al
# inbox de Gmail. Sin ellas, la app sigue funcionando en "modo desarrollo": el
# código se imprime en la consola del servidor y se guarda en lab/data/outbox/,
# y también se muestra en la propia app (útil para pruebas, no para producción).
#
# Cómo obtener una contraseña de aplicación de Gmail:
# 1. Entra con la cuenta de Gmail que va a ENVIAR los correos (puede ser una
#    cuenta @gmail.com normal, o una @cedesdonbosco.ed.cr si el colegio usa
#    Google Workspace y el administrador lo permite).
# 2. Activa la verificación en 2 pasos (obligatoria para poder crear
#    contraseñas de aplicación): https://myaccount.google.com/security
# 3. Crea una contraseña de aplicación: https://myaccount.google.com/apppasswords
#    Elige "Otra (nombre personalizado)", escribe por ejemplo "WISPR" y copia
#    los 16 caracteres que te da Google (sin espacios).
# 4. Pega esos 16 caracteres en SMTP_PASS. NO es tu contraseña normal de Gmail
#    — esa no funciona aquí y Google la rechaza directamente.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu.correo@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM=WISPR <tu.correo@gmail.com>

# Sesiones del modo independiente (opcional): vencimiento por inactividad y
# antigüedad máxima del token.
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7
